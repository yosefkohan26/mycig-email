          "id": "ba8ed19178d04f27b4cd1851fd6ea1f6",
        },
        {
          "binding": "pending_emails_payload",
          "id": "dceb2b97257f4b2fa4331206fa63c41e",
        },
        {
          "binding": "scheduled_emails",
          "id": "df9637af54db4342ae601fcaf3d73db9",
        },
        {
          "binding": "snoozed_emails",
          "id": "d8d101e234744aa5a56c72ded06ee724",
        },
      ],
    },
