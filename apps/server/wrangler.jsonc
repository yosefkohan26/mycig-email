      },
      "kv_namespaces": [
        {
          "binding": "subscribed_accounts",
          "id": "1b16ec53f6194eee982ecd4beb5b3773",
        },
        {
          "binding": "connection_labels",
          "id": "ff15433d59424eebbdb8352240a5236e",
